{
  "name": "@iueev/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "clean": "git clean -xdf .nuxt .output .turbo node_modules",
    "dev": "dotenv-run -- nuxt dev",
    "prepare": "[ ! -d .nuxt ] && nuxt prepare || true",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck --noEmit"
  },
  "dependencies": {
    "@iueev/core": "workspace:*",
    "@iueev/vue": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "vite": "^8.3.0"
  }
}
