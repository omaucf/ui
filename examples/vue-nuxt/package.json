{
  "name": "@example/vue-nuxt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "clean": "git clean -xdf .nuxt .output .turbo node_modules",
    "dev": "dotenv-run -- nuxt dev",
    "prepare": "[ ! -d .nuxt ] && nuxt prepare || true",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@nuxt/image": "^2.1.0",
    "@veehance/core": "workspace:*",
    "@veehance/vue": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "nuxt": "^4.5.2",
    "unocss": "^66.10.0",
    "vite": "^8.2.2"
  }
}
