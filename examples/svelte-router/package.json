{
  "name": "@example/svelte-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "git clean -xdf .router .turbo dist node_modules",
    "dev": "dotenv-run -- vite dev",
    "prepare": "[ ! -d .router ] && sv-router || true",
    "start": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@unpic/svelte": "^1.0.1",
    "@veehance/core": "workspace:*",
    "@veehance/svelte": "workspace:*",
    "sv-router": "^0.18.1",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "unocss": "^66.10.0",
    "vite": "^8.2.2"
  }
}
