{
  "name": "@example/svelte-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "git clean -xdf .output .svelte-kit .turbo .veehance node_modules",
    "dev": "dotenv-run -- vite dev",
    "prepare": "[ ! -d .svelte-kit ] && svelte-kit sync || true",
    "start": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.1",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/tailwind4": "^1.2.3",
    "@unpic/svelte": "^1.0.1",
    "@veehance/core": "workspace:*",
    "@veehance/svelte": "workspace:*",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "vite": "^8.2.2"
  }
}
