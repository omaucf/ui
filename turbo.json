{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "loose",
  "tasks": {
    "start": { "persistent": true },
    "dev": { "cache": false, "interactive": true, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".data/**",
        ".next/**",
        "!.next/cache/**",
        ".nitro/**",
        ".nuxt/**",
        ".output/**",
        ".react-router/**",
        ".router/**",
        ".svelte-kit/**",
        ".tanstack/**",
        ".veehance/**",
        "dist/**"
      ]
    },
    "test": { "outputs": ["coverage/**"] },
    "typecheck": { "outputs": [] },
    "clean": { "cache": false },
    "storybook": { "cache": false, "interactive": true, "persistent": true },
    "storybook-build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
