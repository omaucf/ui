{
  "name": "@veehance/svelte",
  "version": "0.0.0",
  "homepage": "https://github.com/omaucf/ui#readme",
  "bugs": {
    "url": "https://github.com/omaucf/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omaucf/ui.git",
    "directory": "packages/svelte"
  },
  "license": "MIT",
  "author": "@omaucf <omaucf@pm.me>",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#build/app.config": "./node_modules/.veehance/app.config.ts",
    "#build/theme/*": "./node_modules/.veehance/theme/*.ts",
    "#build/ui/*": "./node_modules/.veehance/ui/*.ts",
    "#build/ui.css": "./node_modules/.veehance/ui.css"
  },
  "exports": {
    ".": "./dist/index.js",
    "./app": {
      "types": "./dist/providers/app/index.d.ts",
      "import": "./dist/providers/app/index.js",
      "svelte": "./dist/providers/app/index.js"
    },
    "./color-mode": {
      "types": "./dist/providers/color-mode/index.d.ts",
      "import": "./dist/providers/color-mode/index.js",
      "svelte": "./dist/providers/color-mode/index.js"
    },
    "./color-mode/image": {
      "types": "./dist/components/color-mode/image/index.d.ts",
      "import": "./dist/components/color-mode/image/index.js",
      "svelte": "./dist/components/color-mode/image/index.js"
    },
    "./container": {
      "types": "./dist/components/ui/container/index.d.ts",
      "import": "./dist/components/ui/container/index.js",
      "svelte": "./dist/components/ui/container/index.js"
    },
    "./environment": {
      "types": "./dist/providers/environment/index.d.ts",
      "import": "./dist/providers/environment/index.js",
      "svelte": "./dist/providers/environment/index.js"
    },
    "./factory": {
      "types": "./dist/elements/factory/index.d.ts",
      "import": "./dist/elements/factory/index.js",
      "svelte": "./dist/elements/factory/index.js"
    },
    "./icon": {
      "types": "./dist/elements/icon/index.d.ts",
      "import": "./dist/elements/icon/index.js",
      "svelte": "./dist/elements/icon/index.js"
    },
    "./image": {
      "types": "./dist/elements/image/index.d.ts",
      "import": "./dist/elements/image/index.js",
      "svelte": "./dist/elements/image/index.js"
    },
    "./interaction": {
      "types": "./dist/providers/interaction/index.d.ts",
      "import": "./dist/providers/interaction/index.js",
      "svelte": "./dist/providers/interaction/index.js"
    },
    "./keyboard": {
      "types": "./dist/providers/keyboard/index.d.ts",
      "import": "./dist/providers/keyboard/index.js",
      "svelte": "./dist/providers/keyboard/index.js"
    },
    "./kit": "./dist/kit.js",
    "./link": {
      "types": "./dist/elements/link/index.d.ts",
      "import": "./dist/elements/link/index.js",
      "svelte": "./dist/elements/link/index.js"
    },
    "./link/inertia": {
      "types": "./dist/base/inertia/link/index.d.ts",
      "import": "./dist/base/inertia/link/index.js",
      "svelte": "./dist/base/inertia/link/index.js"
    },
    "./locale": {
      "types": "./dist/providers/locale/index.d.ts",
      "import": "./dist/providers/locale/index.js",
      "svelte": "./dist/providers/locale/index.js"
    },
    "./main": {
      "types": "./dist/components/ui/main/index.d.ts",
      "import": "./dist/components/ui/main/index.js",
      "svelte": "./dist/components/ui/main/index.js"
    },
    "./package.json": "./package.json",
    "./placeholder": {
      "types": "./dist/elements/placeholder/index.d.ts",
      "import": "./dist/elements/placeholder/index.js",
      "svelte": "./dist/elements/placeholder/index.js"
    },
    "./prose/h1": {
      "types": "./dist/components/prose/h1/index.d.ts",
      "import": "./dist/components/prose/h1/index.js",
      "svelte": "./dist/components/prose/h1/index.js"
    },
    "./prose/h2": {
      "types": "./dist/components/prose/h2/index.d.ts",
      "import": "./dist/components/prose/h2/index.js",
      "svelte": "./dist/components/prose/h2/index.js"
    },
    "./prose/h3": {
      "types": "./dist/components/prose/h3/index.d.ts",
      "import": "./dist/components/prose/h3/index.js",
      "svelte": "./dist/components/prose/h3/index.js"
    },
    "./prose/h4": {
      "types": "./dist/components/prose/h4/index.d.ts",
      "import": "./dist/components/prose/h4/index.js",
      "svelte": "./dist/components/prose/h4/index.js"
    },
    "./prose/icon": {
      "types": "./dist/components/prose/icon/index.d.ts",
      "import": "./dist/components/prose/icon/index.js",
      "svelte": "./dist/components/prose/icon/index.js"
    },
    "./types": "./dist/types/index.js",
    "./types/*": "./dist/types/*.js",
    "./ui.css": "./dist/index.css",
    "./unplugin": "./dist/unplugin.js",
    "./use-app-config": "./dist/composables/use-app-config.js",
    "./use-color-mode": "./dist/composables/use-color-mode.js",
    "./use-environment": "./dist/composables/use-environment.js",
    "./use-icon": "./dist/composables/use-icon.js",
    "./use-locale": "./dist/composables/use-locale.js",
    "./utils": "./dist/utils/index.js",
    "./utils/*": "./dist/utils/*.js",
    "./vite": "./dist/vite.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*.css",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "package.json"
  ],
  "scripts": {
    "build": "svelte-package && tsdown",
    "clean": "git clean -xdf .svelte-kit .turbo coverage dist node_modules",
    "dev": "svelte-package && tsdown --watch",
    "prepare": "[ ! -d dist ] && run-s build || true",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook-build": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@unpic/core": "^1.0.3",
    "@veehance/core": "workspace:*",
    "@zag-js/core": "^1.43.3",
    "@zag-js/dom-query": "^1.43.3",
    "@zag-js/focus-visible": "^1.43.3",
    "@zag-js/hotkeys": "^1.43.3",
    "@zag-js/i18n-utils": "^1.43.3",
    "@zag-js/svelte": "^1.43.3",
    "@zag-js/utils": "^1.43.3",
    "tailwind-variants": "^3.3.1",
    "ufo": "^1.6.4",
    "unplugin": "^3.3.0",
    "unplugin-svelte-components": "^0.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/tailwind4": "^1.2.3",
    "@sveltejs/package": "^2.5.8",
    "globby": "^16.2.4",
    "svelte": "^5.57.0"
  },
  "peerDependencies": {
    "@iconify/utils": ">=3",
    "@inertiajs/core": ">=3",
    "@inertiajs/svelte": ">=3",
    "@unpic/svelte": ">=1",
    "defu": ">=6",
    "radashi": ">=12",
    "sv-router": ">=0.16",
    "svelte": ">=5",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "@iconify/utils": {
      "optional": true
    },
    "@inertiajs/core": {
      "optional": true
    },
    "@inertiajs/svelte": {
      "optional": true
    },
    "@unpic/vue": {
      "optional": true
    },
    "defu": {
      "optional": true
    },
    "radashi": {
      "optional": true
    },
    "sv-router": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
