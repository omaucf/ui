{
  "extends": [
    "@tsconfig/recommended/tsconfig.json",
    "@tsconfig/node24/tsconfig.json"
  ],
  "compilerOptions": {
    "module": "nodenext",
    "paths": {
      "#build/*": ["./node_modules/.veehance/*"],
      "@/*": ["./src/lib/*"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
