{
  "name": "@veehance/core",
  "version": "0.0.0",
  "homepage": "https://github.com/omaucf/ui#readme",
  "bugs": {
    "url": "https://github.com/omaucf/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omaucf/ui.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "@omaucf <omaucf@pm.me>",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#build/app.config": "./node_modules/.veehance/app.config.ts",
    "#build/ui/*": "./node_modules/.veehance/ui/*.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./colors": "./dist/lib/colors.js",
    "./config": "./dist/config.js",
    "./constants": "./dist/lib/constants/index.js",
    "./constants/*": "./dist/lib/constants/*.js",
    "./create": "./dist/create.js",
    "./defaults": "./dist/lib/defaults.js",
    "./detection": "./dist/detection.js",
    "./dev": "./dist/dev.js",
    "./functions": "./dist/lib/functions/index.js",
    "./functions/*": "./dist/lib/functions/*.js",
    "./helpers": "./dist/lib/helpers/index.js",
    "./helpers/*": "./dist/lib/helpers/*.js",
    "./iconset": "./dist/iconset/index.js",
    "./iconset/*": "./dist/iconset/*.js",
    "./keyframes.css": "./dist/keyframes.css",
    "./locale": "./dist/locale/index.js",
    "./locale/*": "./dist/locale/*.js",
    "./package.json": "./package.json",
    "./preset": "./dist/preset/index.js",
    "./preset/*": "./dist/preset/*.js",
    "./schemas": "./dist/lib/schemas/index.js",
    "./schemas/*": "./dist/lib/schemas/*.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./template": "./dist/template.js",
    "./templates": "./dist/lib/templates/index.js",
    "./templates/*": "./dist/lib/templates/*.js",
    "./theme": "./dist/theme/index.js",
    "./theme/prose": "./dist/theme/prose/index.js",
    "./theme/prose/*": "./dist/theme/prose/*.js",
    "./theme/ui": "./dist/theme/ui/index.js",
    "./theme/ui/*": "./dist/theme/ui/*.js",
    "./types": "./dist/lib/types/index.js",
    "./types/*": "./dist/lib/types/*.js",
    "./ui.css": "./dist/index.css",
    "./unocss": "./dist/unocss.js",
    "./unplugin": "./dist/unplugin.js",
    "./utils": "./dist/lib/utils/index.js",
    "./utils/*": "./dist/lib/utils/*.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*.css",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .turbo coverage dist node_modules",
    "dev": "tsdown --watch",
    "prepare": "[ ! -d dist ] && run-s build || true",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify/utils": "^3.1.5",
    "globby": "^16.2.4",
    "mlly": "^1.8.2",
    "pathe": "^2.0.3",
    "radashi": "^12.9.1",
    "unplugin-auto-import": "^21.1.0",
    "vite-plugin-webfont-dl": "^3.13.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.129"
  },
  "peerDependencies": {
    "@tailwindcss/vite": ">=4",
    "defu": ">=6",
    "tailwind-variants": ">=3",
    "unocss": ">=66",
    "unplugin": ">=3",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "defu": {
      "optional": true
    },
    "tailwind-variants": {
      "optional": true
    },
    "unocss": {
      "optional": true
    },
    "unplugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
