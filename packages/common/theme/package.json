{
  "name": "@iueev/theme",
  "version": "0.0.0",
  "homepage": "https://github.com/omaucf/ui#readme",
  "bugs": {
    "url": "https://github.com/omaucf/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omaucf/ui.git",
    "directory": "packages/common/theme"
  },
  "license": "MIT",
  "author": "@omaucf <omaucf@pm.me>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./prose": "./dist/prose/index.js",
    "./prose/*": "./dist/prose/*.js",
    "./ui": "./dist/ui/index.js",
    "./ui/*": "./dist/ui/*.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .turbo coverage dist node_modules",
    "dev": "tsdown --watch",
    "prepare": "[ ! -d dist ] && run-s build || true",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
